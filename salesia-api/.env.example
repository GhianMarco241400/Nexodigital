DATABASE_URL=postgresql+psycopg://postgres.PROYECTO:CONTRASEÑA@HOST.pooler.supabase.com:5432/postgres
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# JWT_SECRET debe tener al menos 32 caracteres. Genera uno real con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR_POR_VALOR_ALEATORIO
JWT_EXPIRE_MINUTES=60

# AWS Price List Query API (solo lectura, gratuito). Credenciales del proyecto.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CAMBIAR
AWS_SECRET_ACCESS_KEY=CAMBIAR
# Opcional: token de sesión temporal (si se usan credenciales STS).
# AWS_SESSION_TOKEN=
# Modo del catálogo: "simulation" (tarifas locales) o "live" (Price List API real).
# El valor guardado en app_settings (BD) tiene prioridad sobre esta variable.
CATALOG_MODE=simulation

# Revisión de pedidos con IA: "heuristic" (solo reglas), "llm" (proveedor de IA)
# o "hybrid" (reglas + resumen redactado por el LLM).
# El valor guardado en app_settings (BD, keys 'review_mode'/'review_provider'/
# 'review_model') tiene prioridad y se cambia en caliente desde la UI de SalesIA.
REVIEW_MODE=heuristic
# Proveedor por defecto: gemini | groq | openrouter | ollama | openai.
REVIEW_PROVIDER=gemini

# Solo el proveedor activo necesita su clave. Pegar la clave exige reiniciar el
# servidor. Gemini (gratis): https://aistudio.google.com/apikey
# GEMINI_API_KEY=CAMBIAR
# GEMINI_MODEL=gemini-flash-lite-latest
# Groq (gratis): https://console.groq.com/keys
# GROQ_API_KEY=CAMBIAR
# GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter (modelos :free): https://openrouter.ai/keys
# OPENROUTER_API_KEY=CAMBIAR
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
# Ollama (local, sin clave)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OpenAI (de pago): https://platform.openai.com/api-keys
# OPENAI_API_KEY=CAMBIAR
# OPENAI_MODEL=gpt-4o-mini
